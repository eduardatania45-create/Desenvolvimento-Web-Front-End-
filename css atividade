body {
    background-color: #dceff2;
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 40px;
}

.perfil {
    width: 500px;
    margin: 40px auto;
    padding: 30px;
    background-color: white;
    border: 2px solid #999;
    border-radius: 15px;
}

h1 {
    color: #333;
    font-size: 32px;
    text-align: center;
}

h2 {
    color: #666;
    font-size: 20px;
    text-align: center;
}

.descricao {
    color: #555;
    font-size: 16px;
    line-height: 1.5;
}

h3 {
    color: #444;
    font-size: 20px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 8px;
}

.habilidades {
    background-color: #f5f5f5;
    padding: 20px 40px;
    border-radius: 8px;
}

.habilidades li {
    margin: 10px 0;
    color: #555;
}

.contato {
    color: #555;
    font-size: 16px;
}

.botao {
    display: inline-block;
    background-color: #777;
    color: white;
    padding: 12px 20px;
    border: 1px solid #666;
    border-radius: 8px;
    text-decoration: none;
    margin-top: 10px;
}

.botao:hover {
    background-color: #333;
    color: white;
}
